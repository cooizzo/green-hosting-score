DATABASE_URL="postgresql://ghs:ghs@localhost:5432/ghs?schema=public"
POSTGRES_USER=ghs
POSTGRES_PASSWORD=ghs
POSTGRES_DB=ghs
# Canonical public URL for badge/share links. Leave unset to use the request Host
# (Compose via Caddy is http://localhost; `npm run dev` is http://localhost:3000).
# APP_URL=http://localhost
# Set to "true" to skip Greencheck / Website Carbon (offline / tests)
MOCK_SCORER=false
