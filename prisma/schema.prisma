generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeasureMode {
  fast
  accurate
}

model AnalysisResult {
  id             String      @id @default(cuid())
  slug           String      @unique
  url            String
  hostname       String
  mode           MeasureMode
  bytes          Int
  green          Boolean
  gco2e          Float
  rating         String
  cleanerThan    Float?
  gridLabel      String?
  gridIntensity  Float?
  fixes          Json
  mocked         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  expiresAt      DateTime

  @@index([hostname, mode, createdAt])
  @@index([expiresAt])
}

model ApiKey {
  id         String   @id @default(cuid())
  name       String
  keyHash    String   @unique
  keyPrefix  String
  dailyLimit Int      @default(100)
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String
  windowStart DateTime
  count     Int      @default(0)

  @@unique([key, windowStart])
  @@index([key])
}
